{
    "firestore":  {
                      "database":  "(default)",
                      "location":  "asia-south1",
                      "rules":  "firestore.rules",
                      "indexes":  "firestore.indexes.json"
                  },
    "functions":  [
                      {
                          "source":  "functions",
                          "codebase":  "default",
                          "disallowLegacyRuntimeConfig":  true,
                          "ignore":  [
                                         "node_modules",
                                         ".git",
                                         "firebase-debug.log",
                                         "firebase-debug.*.log",
                                         "*.local"
                                     ],
                          "predeploy":  [
                                            "npm --prefix \"$RESOURCE_DIR\" run lint",
                                            "npm --prefix \"$RESOURCE_DIR\" run build"
                                        ]
                      },
                      {
                          "source":  "functions-ai",
                          "codebase":  "disease-ai",
                          "runtime":  "python313",
                          "ignore":  [
                                         ".venv",
                                         "venv",
                                         "__pycache__",
                                         ".git",
                                         "firebase-debug.log",
                                         "firebase-debug.*.log",
                                         "*.local"
                                     ]
                      }
                  ],
    "apphosting":  {
                       "backendId":  "kisan-mithra-web",
                       "rootDir":  "frontend",
                       "ignore":  [
                                      "node_modules",
                                      ".git",
                                      "firebase-debug.log",
                                      "firebase-debug.*.log",
                                      "functions"
                                  ]
                   },
    "storage":  {
                    "rules":  "storage.rules"
                }
}
